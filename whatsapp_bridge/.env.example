# Copy to whatsapp_bridge/.env and fill in. Never commit the real file.

# Kapso: Integrations -> API keys
KAPSO_API_KEY=
# The secret_key you pick when registering the webhook (see README step 3)
KAPSO_WEBHOOK_SECRET=
# Optional fallback; webhooks normally carry it. `kapso whatsapp numbers list`
KAPSO_PHONE_NUMBER_ID=

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Your own number(s), digits only, comma-separated. Leave empty and anyone who
# finds the number can chat on your API credits.
ALLOWED_NUMBERS=

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max
# HISTORY_TURNS=20
# SYSTEM_PROMPT=...
